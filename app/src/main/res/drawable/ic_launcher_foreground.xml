                android:type="linear"
                android:startX="128" android:startY="84"
                android:endX="128" android:endY="140">
                <item android:color="#80ffbf" android:offset="0.0"/>
                <item android:color="#00e673" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
