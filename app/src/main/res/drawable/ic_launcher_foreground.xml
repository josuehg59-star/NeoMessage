        android:strokeLineJoin="round"
        android:pathData="M 68,64 H 188 A 12,12 0 0 1 200,76 V 148 A 12,12 0 0 1 188,160 H 152 L 118,198 L 108,160 H 68 A 12,12 0 0 1 56,148 V 76 A 12,12 0 0 1 68,64 Z">
