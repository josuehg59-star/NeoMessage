                android:startX="128" android:startY="64"
                android:endX="128" android:endY="198">
                <item android:color="#0a1f14" android:offset="0.0"/>
                <item android:color="#040d08" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Borde Exterior de la Burbuja N (Glow Verde Neón) -->
