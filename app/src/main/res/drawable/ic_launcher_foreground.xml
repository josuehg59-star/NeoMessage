                <item android:color="#008c46" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- La letra 'N' interna verde neón -->
    <path
        android:pathData="M 90,140 V 84 H 106 L 148,126 V 84 H 164 V 140 H 148 L 106,98 V 140 Z">
        <aapt:attr name="android:fillColor">
